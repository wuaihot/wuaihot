{
  "crons": [{"path": "/api/ai-qwen-official", "schedule": "0 1 * * *"}],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/api/[...path].js" },
    {
      "src": "^/assets/.*-[a-f0-9]{8}\\.(?:js|css|woff2?|svg|png|jpe?g|webp|avif)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "^/assets/(.*)$", "status": 404, "headers": { "Cache-Control": "no-store" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
